# ---------------------------------------------------------------------------
# Garden Explorer — environment variables
#
# Copy to `.env.local` for development, and add the same keys to Vercel for
# Preview and Production. NEVER commit a real `.env` file.
# Only variables prefixed with NEXT_PUBLIC_ are visible in the browser.
# ---------------------------------------------------------------------------

# --- Database (Neon PostgreSQL) --------------------------------------------
# Neon dashboard -> your project -> Connection string -> "Pooled connection".
# Must include `?sslmode=require`.
DATABASE_URL=

# --- Admin authentication (Better Auth) ------------------------------------
# Generate with:  openssl rand -base64 32
# Must be at least 32 characters. Rotating this invalidates all admin sessions.
BETTER_AUTH_SECRET=

# Canonical origin of the deployment, no trailing slash.
# Local:  http://localhost:3000
# Vercel: https://your-project.vercel.app
BETTER_AUTH_URL=

# --- Media (Cloudinary) ----------------------------------------------------
# Cloudinary dashboard -> Product Environment Credentials.
# The API SECRET is server-only and must never be prefixed with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Folder inside your Cloudinary account where garden media is stored.
CLOUDINARY_UPLOAD_FOLDER=garden-explorer

# --- Public app URL --------------------------------------------------------
# Used for QR payloads, canonical URLs, sitemap and Open Graph metadata.
# Must be the final public URL because printed QR codes encode it.
NEXT_PUBLIC_APP_URL=

# --- Optional --------------------------------------------------------------
# Only needed if you want extra salt mixed into the anonymous visitor ID.
GARDEN_ANALYTICS_SALT=
